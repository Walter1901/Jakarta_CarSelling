<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Identité du projet -->
  <groupId>ch.hevs</groupId>
  <artifactId>Jakarta_CarSelling</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>war</packaging>
  <name>Jakarta CarSelling</name>

  <properties>
    <!-- Le cours utilise Java 21 dans vos TPs -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- WildFly 27 = Jakarta EE 10 -->
    <jakartaee.version>10.0.0</jakartaee.version>

    <!-- Plugins -->
    <maven.war.plugin.version>3.4.0</maven.war.plugin.version>
    <wildfly.maven.plugin.version>5.1.3.Final</wildfly.maven.plugin.version>
  </properties>

  <dependencies>
    <!-- APIs Jakarta fournies par WildFly -->
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-web-api</artifactId>
      <version>${jakartaee.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>

    <!-- HSQLDB seulement pour tests locaux si vous en faites -->
    <dependency>
      <groupId>org.hsqldb</groupId>
      <artifactId>hsqldb</artifactId>
      <version>2.7.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>${maven.war.plugin.version}</version>
      </plugin>

      <!-- Déploiement sur WildFly via Maven si vous l’utilisez -->
      <plugin>
        <groupId>org.wildfly.plugins</groupId>
        <artifactId>wildfly-maven-plugin</artifactId>
        <version>${wildfly.maven.plugin.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
